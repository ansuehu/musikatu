{
  "name": "earwork-ai",
  "productName": "Earwork AI",
  "version": "0.1.0",
  "description": "Precision playback workbench for transcribing music by ear, with on-device AI instrument separation",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "install:linux": "npm run dist:dir && bash scripts/install-linux.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "author": {
    "name": "Andoni Sudupe",
    "email": "andonisudupeehu@gmail.com"
  },
  "build": {
    "appId": "eus.ehu.earwork.ai",
    "productName": "Earwork AI",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!node_modules/onnxruntime-node/bin/**/*tensorrt*",
      "!node_modules/onnxruntime-node/bin/**/*providers_cuda*",
      "!node_modules/onnxruntime-node/bin/**/arm64/**"
    ],
    "fileAssociations": [
      {
        "ext": [
          "wav",
          "mp3",
          "flac",
          "m4a",
          "aac",
          "ogg",
          "opus",
          "aif",
          "aiff"
        ],
        "name": "Audio",
        "role": "Viewer"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ],
      "files": [
        "!node_modules/onnxruntime-node/bin/**/win32/**",
        "!node_modules/onnxruntime-node/bin/**/linux/**"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "files": [
        "!node_modules/onnxruntime-node/bin/**/linux/**",
        "!node_modules/onnxruntime-node/bin/**/darwin/**"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Audio",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "files": [
        "!node_modules/onnxruntime-node/bin/**/win32/**",
        "!node_modules/onnxruntime-node/bin/**/darwin/**"
      ],
      "icon": "build/icon.png",
      "executableName": "earwork-ai",
      "maintainer": "Andoni Sudupe <andonisudupeehu@gmail.com>",
      "synopsis": "Music transcription workbench with on-device AI stem separation"
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "electron/beats/models/**"
    ]
  },
  "dependencies": {
    "onnxruntime-node": "^1.30.0"
  },
  "desktopName": "earwork-ai.desktop",
  "homepage": "mailto:andonisudupeehu@gmail.com"
}
