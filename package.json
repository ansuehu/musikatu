{
  "name": "earwork",
  "productName": "Earwork",
  "version": "0.1.0",
  "description": "Precision audio playback workbench for transcribing music by ear",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "author": {
    "name": "Andoni Sudupe",
    "email": "andonisudupeehu@gmail.com"
  },
  "build": {
    "appId": "eus.ehu.earwork",
    "productName": "Earwork",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "wav",
          "mp3",
          "flac",
          "m4a",
          "aac",
          "ogg",
          "opus",
          "aif",
          "aiff"
        ],
        "name": "Audio",
        "role": "Viewer"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Audio",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
